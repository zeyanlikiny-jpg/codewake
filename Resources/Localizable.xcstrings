    "“Only while charging” is on, so connect your Mac to power to keep it awake.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Only while charging” is on, so connect your Mac to power to keep it awake."
          }
        },
        "zh-Hans": {
          "stringUnit": {
