    "CodeWake changes only the macOS default input. Apps that use a fixed microphone may not follow it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeWake changes only the macOS default input. Apps that use a fixed microphone may not follow it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeWake · 醒码 只更改 macOS 默认输入。使用固定麦克风的应用可能不会跟随切换。"
          }
        }
      }
    },
    "Microphone input": {
