    "Let coding agents, downloads, or builds keep running while the closed Mac stays plugged in on a cool, ventilated desk. Never put it in a bag while keep-awake is active.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let coding agents, downloads, or builds keep running while the closed Mac stays plugged in on a cool, ventilated desk. Never put it in a bag while keep-awake is active."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将合盖的 Mac 接通电源并放在阴凉通风的桌面上，让编码智能体、下载或构建继续运行。保持唤醒时，切勿将 Mac 放入包中。"
          }
        }
      }
    },
