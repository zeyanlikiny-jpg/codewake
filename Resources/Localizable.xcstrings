{
  "sourceLanguage": "en",
  "strings": {
    "Double-click to turn off the built-in display." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-click to turn off the built-in display."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速双击可执行内屏熄灭。"
          }
        }
      }
    },
    "The built-in display is not ready. Open the lid and wait for brightness to recover, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The built-in display is not ready. Open the lid and wait for brightness to recover, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置屏幕尚未就绪。请打开上盖，等待亮度恢复后重试。"
          }
        }
      }
    },
    "Built-in brightness recovery failed. Raise the built-in display brightness and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in brightness recovery failed. Raise the built-in display brightness and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内屏亮度恢复失败。请调高内置屏幕亮度后重试。"
          }
        }
      }
    },
    "Couldn’t confirm the lid or display state. Wait for the displays to reconnect and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t confirm the lid or display state. Wait for the displays to reconnect and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认上盖或显示器状态。请等待显示器重新连接后重试。"
          }
        }
      }
    },
    "The saved brightness recovery record could not be verified. It has been preserved; display sleep was not requested.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved brightness recovery record could not be verified. It has been preserved; display sleep was not requested."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证保存的亮度恢复记录。记录已保留，未发起熄屏请求。"
          }
        }
      }
    },
    "The brightness recovery process is unavailable. Open the lid to restore brightness before trying again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The brightness recovery process is unavailable. Open the lid to restore brightness before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "亮度恢复程序暂不可用。请打开上盖恢复亮度后重试。"
          }
        }
      }
    },
    "Built-in display recovery encountered an error. The recovery record has been preserved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in display recovery encountered an error. The recovery record has been preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置屏幕恢复出错，恢复记录已保留。"
          }
        }
      }
    },
    "Built-in display recovery is taking too long. Wait for brightness to recover and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in display recovery is taking too long. Wait for brightness to recover and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内屏亮度恢复用时过长。请等待亮度恢复后重试。"
          }
        }
      }
    },
    "The lid is closed. Built-in brightness will recover when opened; external displays can still be turned off.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lid is closed. Built-in brightness will recover when opened; external displays can still be turned off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内屏已合盖，开盖后自动恢复亮度；仍可熄灭外接屏幕。"
          }
        }
      }
    },
    "Built-in display brightness recovery is pending.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in display brightness recovery is pending."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内屏亮度等待恢复。"
          }
        }
      }
    },
    "All displays": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All displays"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部屏幕"
          }
        }
      }
    },
    "Turn Off All Displays": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Off All Displays"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部熄屏"
          }
        }
      }
    },
    "Turning Off Displays…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning Off Displays…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在熄屏…"
          }
        }
      }
    },
    "Turns off the built-in and all external displays after 1.5 seconds. Move the mouse or press a key to restore the displays. The Mac keeps its current keep-awake rules.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns off the built-in and all external displays after 1.5 seconds. Move the mouse or press a key to restore the displays. The Mac keeps its current keep-awake rules."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1.5 秒后熄灭内置和所有外接屏幕。移动鼠标或按键恢复显示，电脑沿用现有防睡眠规则。"
          }
        }
      }
    },
    "Couldn’t restore the built-in display before turning off all displays.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t restore the built-in display before turning off all displays."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法先恢复内置屏幕，因此未能熄灭全部屏幕。"
          }
        }
      }
    },
    "Couldn’t start the display sleep request.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t start the display sleep request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法发起屏幕熄灭请求。"
          }
        }
      }
    },
    "macOS couldn’t turn off all displays.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS couldn’t turn off all displays."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 无法熄灭全部屏幕。"
          }
        }
      }
    },
    "The display sleep request timed out.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The display sleep request timed out."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕熄灭请求超时。"
          }
        }
      }
    },
    "macOS didn’t confirm that all displays turned off.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS didn’t confirm that all displays turned off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 未能确认全部屏幕已熄灭。"
          }
        }
      }
    },
    "audio.input.choice.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (Unavailable)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（不可用）"
          }
        }
      }
    },
    "audio.input.current.accessibility": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current system input: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前系统输入：%@"
          }
        }
      }
    },
    "audio.input.switch.accessibility": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch system input to %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将系统输入切换到 %@"
          }
        }
      }
    },
    "audio.input.switch.button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换到 %@"
          }
        }
      }
    },
    "audio.input.switch.reconnecting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for %@ to reconnect…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待 %@ 重新连接…"
          }
        }
      }
    },
    "audio.input.switch.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不可用"
          }
        }
      }
    },
    "Changes the macOS default input. Apps pinned to another microphone may not follow it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes the macOS default input. Apps pinned to another microphone may not follow it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改 macOS 默认输入。已固定使用其他麦克风的应用可能不会跟随切换。"
          }
        }
      }
    },
    "Connection unstable — switching paused": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection unstable — switching paused"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接不稳定，已暂停切换"
          }
        }
      }
    },
    "Couldn’t confirm microphone status": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t confirm microphone status"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认麦克风状态"
          }
        }
      }
    },
    "Couldn’t confirm whether the current microphone is in use. Switching is paused for safety.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t confirm whether the current microphone is in use. Switching is paused for safety."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认当前麦克风是否正在使用，已为安全起见暂停切换。"
          }
        }
      }
    },
    "Input devices changed. Please try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input devices changed. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入设备已变化，请重试。"
          }
        }
      }
    },
    "Microphone in use": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone in use"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风正在使用"
          }
        }
      }
    },
    "Please wait…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please wait…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍候…"
          }
        }
      }
    },
    "The input device is reconnecting. Switching will be available when it is stable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The input device is reconnecting. Switching will be available when it is stable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入设备正在重新连接，稳定后才能切换。"
          }
        }
      }
    },
    "The microphone is being used by another app. Stop recording before switching.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is being used by another app. Stop recording before switching."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风正在被其他应用使用，请停止录音后再切换。"
          }
        }
      }
    },
    "The target input became unavailable before switching.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The target input became unavailable before switching."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标输入设备在切换前变为不可用。"
          }
        }
      }
    },
    "The target input is unstable. Try again when it is ready.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The target input is unstable. Try again when it is ready."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标输入设备状态不稳定，请在就绪后重试。"
          }
        }
      }
    },
    "This input device has disconnected repeatedly. Switching will resume automatically when the connection is stable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This input device has disconnected repeatedly. Switching will resume automatically when the connection is stable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该输入设备近期反复断开，连接稳定后会自动恢复。"
          }
        }
      }
    },
    "Choose a different device for each slot. Unavailable inputs stay saved until they reconnect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a different device for each slot. Unavailable inputs stay saved until they reconnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请为每个位置选择不同的设备。不可用的输入会保留，重新连接后即可使用。"
          }
        }
      }
    },
    "Choose an input…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an input…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择输入设备…"
          }
        }
      }
    },
    "Choose two different input devices. Offline selections stay saved and become available again when reconnected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose two different input devices. Offline selections stay saved and become available again when reconnected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择两个不同的输入设备。离线选择会保留，并在重新连接后恢复可用。"
          }
        }
      }
    },
    "Configure Input Switching…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure Input Switching…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置输入切换…"
          }
        }
      }
    },
    "Couldn’t monitor system input changes. CodeWake will refresh before switching.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t monitor system input changes. CodeWake will refresh before switching."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法实时监控系统输入变化。CodeWake · 醒码 会在切换前刷新。"
          }
        }
      }
    },
    "Couldn’t read the available system input devices.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read the available system input devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取可用的系统输入设备。"
