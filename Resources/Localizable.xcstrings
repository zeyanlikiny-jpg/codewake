          }
        }
      }
    },
    "Keep display awake": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep display awake"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持屏幕常亮"
          }
        }
      }
    },
    "Keep display awake during activity": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep display awake during activity"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动期间保持屏幕常亮"
          }
        }
      }
    },
    "Only prevents idle display sleep during active AI work or a manual or timed hold. Waiting, completion confirmation, and charging-only holds do not keep it on. It does not light a sleeping display or override lid-closed behavior.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only prevents idle display sleep during active AI work or a manual or timed hold. Waiting, completion confirmation, and charging-only holds do not keep it on. It does not light a sleeping display or override lid-closed behavior."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在 AI 正在工作、手动保持或计时保持期间防止显示器因闲置熄灭。等待输入、确认完成或仅充电保持时不会常亮。它不会点亮已熄灭的屏幕，也不会覆盖合盖行为。"
          }
        }
      }
    },
    "Prevents idle display sleep only during active AI work or a manual or timed hold—not while waiting, confirming completion, or charging alone. It doesn’t light a sleeping display or override lid-closed behavior.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevents idle display sleep only during active AI work or a manual or timed hold—not while waiting, confirming completion, or charging alone. It doesn’t light a sleeping display or override lid-closed behavior."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在 AI 正在工作、手动保持或计时保持期间防止显示器因闲置熄灭；等待输入、确认完成或仅充电保持时不会常亮。它不会点亮已熄灭的屏幕，也不会覆盖合盖行为。"
          }
        }
      }
    },
    "Keep your Mac awake — even with the lid closed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your Mac awake — even with the lid closed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使合上上盖，也让 Mac 保持唤醒。"
          }
        }
      }
    },
    "Keep your Mac plugged in and ventilated under heavy use.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your Mac plugged in and ventilated under heavy use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高负载使用时，请保持 Mac 接通电源并通风良好。"
          }
        }
      }
    },
    "Keep-awake did not hold after a retry. CodeWake released its lease to avoid reporting unsafe protection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep-awake did not hold after a retry. CodeWake released its lease to avoid reporting unsafe protection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试后仍无法保持唤醒。CodeWake · 醒码 已释放租约，以免错误报告不安全的保护状态。"
          }
        }
      }
    },
    "Keeps active AI coding work awake, then restores the Mac’s normal sleep policy when work finishes or an input wait expires.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps active AI coding work awake, then restores the Mac’s normal sleep policy when work finishes or an input wait expires."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 编码工作进行时让 Mac 保持唤醒，并在工作完成或等待输入超时后恢复正常睡眠策略。"
          }
        }
      }
    },
