          }
        }
      }
    },
    "A manual, timed, or charging hold remains in control after AI work finishes. Leave the main manual switch off when you want AI completion to put a closed Mac to sleep.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A manual, timed, or charging hold remains in control after AI work finishes. Leave the main manual switch off when you want AI completion to put a closed Mac to sleep."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 工作结束后，手动、计时或充电保持仍具有优先权。如果希望 AI 完成后让合盖的 Mac 进入睡眠，请关闭主手动开关。"
          }
        }
      }
    },
