    "Install and approve the background helper before using keep-awake. It owns persistent system-sleep changes and restores the prior state after a crash or timeout.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install and approve the background helper before using keep-awake. It owns persistent system-sleep changes and restores the prior state after a crash or timeout."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用保持唤醒前，请安装并批准后台辅助程序。它负责持久的系统睡眠变更，并会在崩溃或超时后恢复之前的状态。"
          }
        }
      }
    },
    "Install and approve the background helper before using keep-awake. It records ownership before changing macOS power state, so crashes and timeouts can recover safely.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install and approve the background helper before using keep-awake. It records ownership before changing macOS power state, so crashes and timeouts can recover safely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用保持唤醒前，请安装并批准后台辅助程序。它会先记录所有权，再更改 macOS 电源状态，以便在崩溃或超时后安全恢复。"
          }
        }
      }
    },
    "Install background helper…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install background helper…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装后台辅助程序…"
          }
        }
      }
    },
    "Install integrations…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install integrations…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装集成…"
          }
        }
      }
    },
    "Install privacy-minimized lifecycle hooks shared by Codex Desktop, Codex CLI, and Claude Code. They send only opaque IDs/tokens, event type, background-work count, and time — never prompts, answers, paths, commands, or source code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install privacy-minimized lifecycle hooks shared by Codex Desktop, Codex CLI, and Claude Code. They send only opaque IDs/tokens, event type, background-work count, and time — never prompts, answers, paths, commands, or source code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装由 Codex Desktop、Codex CLI 和 Claude Code 共用的隐私最小化生命周期 hooks。它们仅发送不透明 ID/令牌、事件类型、后台工作数量和时间，绝不会发送提示词、回答、路径、命令或源代码。"
          }
        }
      }
    },
    "Install the CodeWake background helper before enabling keep-awake.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the CodeWake background helper before enabling keep-awake."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用保持唤醒前，请安装 CodeWake · 醒码 后台辅助程序。"
          }
        }
      }
    },
    "Install the safety helper": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the safety helper"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装安全辅助程序"
          }
        }
      }
    },
    "Installed configuration and observed runtime events are separate. Each surface is verified only after its current bridge sends a real lifecycle event. The bridge sends only opaque IDs/tokens, event kind, background-work count, and time — never prompts, answers, commands, paths, or source code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed configuration and observed runtime events are separate. Each surface is verified only after its current bridge sends a real lifecycle event. The bridge sends only opaque IDs/tokens, event kind, background-work count, and time — never prompts, answers, commands, paths, or source code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装的配置与观察到的运行事件相互独立。只有当前桥接发送真实生命周期事件后，才会验证对应界面。桥接仅发送不透明 ID/令牌、事件类型、后台工作数量和时间，绝不会发送提示词、回答、命令、路径或源代码。"
          }
        }
      }
    },
    "Built-in display": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in display"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置屏幕"
          }
        }
      }
    },
    "Built-in display brightness control is unavailable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in display brightness control is unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置屏幕亮度控制不可用。"
          }
        }
      }
    },
    "Display status could not be confirmed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display status could not be confirmed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认显示器状态。"
          }
        }
      }
    },
    "For 1.5 seconds after turn-off, pointer movement, dragging, and scrolling do not restore brightness. Click again or press a regular key to restore immediately; after that, any input restores brightness.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For 1.5 seconds after turn-off, pointer movement, dragging, and scrolling do not restore brightness. Click again or press a regular key to restore immediately; after that, any input restores brightness."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "熄屏后 1.5 秒内，移动、拖动和滚动不会恢复亮度。再次点击或按下普通按键会立即恢复；之后任意输入都会恢复亮度。"
          }
        }
      }
    },
    "Restore Built-in Display": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore Built-in Display"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复内屏"
          }
        }
      }
    },
    "Sets only the built-in display brightness to zero. For 1.5 seconds after turn-off, pointer movement, dragging, and scrolling do not restore brightness. Click again or press a regular key to restore immediately; after that, any input restores brightness.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets only the built-in display brightness to zero. For 1.5 seconds after turn-off, pointer movement, dragging, and scrolling do not restore brightness. Click again or press a regular key to restore immediately; after that, any input restores brightness."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅将内置屏幕亮度设为零。熄屏后 1.5 秒内，移动、拖动和滚动不会恢复亮度。再次点击或按下普通按键会立即恢复；之后任意输入都会恢复亮度。"
          }
        }
      }
    },
    "The built-in display is offline. Brightness will be restored when it reconnects.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The built-in display is offline. Brightness will be restored when it reconnects."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置屏幕已离线，重新上线后将恢复亮度。"
          }
        }
      }
    },
    "Turn Off Built-in Display": {
